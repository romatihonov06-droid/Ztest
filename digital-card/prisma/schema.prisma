generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  links       Link[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
}

model Link {
  id        Int     @id @default(autoincrement())
  label     String
  url       String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id])
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  category  String?
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id])
}

model Experience {
  id           Int      @id @default(autoincrement())
  company      String
  position     String
  startDate    String
  endDate      String?
  achievements String[]
  profileId    Int
  profile      Profile  @relation(fields: [profileId], references: [id])
}

model Project {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  url         String?
  profileId   Int
  profile     Profile @relation(fields: [profileId], references: [id])
}
